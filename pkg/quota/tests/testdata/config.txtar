#! --resource-quotas=*:cilium.io/hostports-per-node=100k --resource-quotas=*:cilium.io/serviceports=12 --resource-quotas=team-a:cilium.io/hostports-per-node=500
# This file was not reviewed by a human before submission
hive start

db/cmp resource-quotas quotas.table
quota/reserve default cilium.io/hostports-per-node test 100000
db/cmp resource-quotas used.table
! quota/reserve default cilium.io/hostports-per-node another 1
quota/release default cilium.io/hostports-per-node test
db/cmp resource-quotas quotas.table

# Namespace limits override defaults and remain present after release.
quota/reserve team-a cilium.io/hostports-per-node test 500
db/cmp resource-quotas namespace-used.table
! quota/reserve team-a cilium.io/hostports-per-node another 1
quota/release team-a cilium.io/hostports-per-node test
db/cmp resource-quotas quotas.table

# Other resources in the same namespace still inherit wildcard defaults.
quota/reserve team-a cilium.io/serviceports inherited 12
db/cmp resource-quotas inherited-used.table
! quota/reserve team-a cilium.io/serviceports extra 1
quota/release team-a cilium.io/serviceports inherited
db/cmp resource-quotas quotas.table

